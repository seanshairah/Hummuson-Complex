# ── Database ──────────────────────────────────────────────────────────────────
# Production: use a Neon PostgreSQL connection string (pooled) —
#   postgresql://USER:PASSWORD@HOST/humuson?sslmode=require
# Local development: `npm run setup:db` boots a local cluster matching this URL.
DATABASE_URL="postgresql://humuson:humuson@localhost:5432/humuson"

# ── Auth.js ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# WhatsApp business number in international format without "+" (used for
# wa.me deep links and the floating WhatsApp actions).
NEXT_PUBLIC_WHATSAPP_NUMBER="263776656433"

# ── Seed admin user (created/updated by `npm run db:seed`) ────────────────────
ADMIN_EMAIL="admin@humusoncomplex.com"
ADMIN_PASSWORD="change-me-immediately"
ADMIN_NAME="Humuson Admin"

# ── Optional: sign-in throttling ──────────────────────────────────────────────
# Failed sign-ins are limited per account (5 per 15 minutes, not tunable) and
# per client address. Raise the per-address ceiling only if legitimate staff
# share one outbound IP — a whole office behind a single NAT, for example.
LOGIN_IP_ATTEMPT_LIMIT="30"

# ── Optional: data retention ──────────────────────────────────────────────────
# The retention sweep (daily, see vercel.json) reports what it would delete but
# deletes nothing until this is set to "1". Deleting a customer's enquiry is a
# business decision, so it is deliberately not the default. Review the numbers
# first with:  npm run maintenance:prune
DATA_RETENTION_ENABLED=""
# Windows in days. Defaults shown; override only with a decision behind it.
# RETENTION_SEARCH_DAYS="180"      # visitor search queries (free text)
# RETENTION_QUESTION_DAYS="180"    # questions asked of Ask Humuson (free text)
# RETENTION_ANALYTICS_DAYS="365"   # page and interaction counters
# RETENTION_ENQUIRY_DAYS="730"     # resolved/archived enquiries; open ones are never swept
# RETENTION_AUDIT_DAYS="400"       # must not be shorter than the database trigger allows
#
# Set by Vercel when a Cron job is configured; the sweep endpoint refuses every
# request without it, rather than defaulting to open.
CRON_SECRET=""

# ── Optional: product analytics (PostHog). Leave empty to disable. ────────────
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# ── Optional: media storage (Cloudinary). Leave empty to use local storage. ───
CLOUDINARY_URL=""
